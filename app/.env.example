# BSL · pega aquí los datos de tu proyecto NUEVO de Supabase (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# 1 = el ingreso por celular (código SMS) va primero. Requiere un proveedor de SMS en Supabase Auth.
EXPO_PUBLIC_PHONE_AUTH=0

# Clave de Google Maps (solo para compilar el APK; en Expo Go no hace falta)
GOOGLE_MAPS_API_KEY=
